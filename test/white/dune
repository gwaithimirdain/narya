(tests
 (names readback pbij library_modified)
 (modules readback pbij library_modified)
 (libraries core parser testutil top unix zarith))

(executable
 (name modal_closure)
 (modules modal_closure)
 (libraries modal asai))

; Check that the decision procedures of the locally posetal mode theories, and of the enumerating ones, are closed under the operations generating 2-cells (see modal_closure.ml).

(rule
 (with-stdout-to
  modal_closure.output
  (progn
   (run %{exe:modal_closure.exe} trivial 8)
   (run %{exe:modal_closure.exe} functor 8)
   (run %{exe:modal_closure.exe} composable-functors 8)
   (run %{exe:modal_closure.exe} transformation 8)
   (run %{exe:modal_closure.exe} composable-transformations 8)
   (run %{exe:modal_closure.exe} interchange 8)
   (run %{exe:modal_closure.exe} reflector 8)
   (run %{exe:modal_closure.exe} coreflector 8)
   (run %{exe:modal_closure.exe} coreflection 8)
   (run %{exe:modal_closure.exe} spatial 7)
   (run %{exe:modal_closure.exe} cospatial 7)
   (run %{exe:modal_closure.exe} local 6)
   (run %{exe:modal_closure.exe} tconn 6)
   (run %{exe:modal_closure.exe} guarded 6)
   (run %{exe:modal_closure.exe} ambiflector 8)
   (run %{exe:modal_closure.exe} ambiflection 8)
   (run %{exe:modal_closure.exe} adjunction 7))))

(rule
 (alias runtest)
 (action
  (diff modal_closure.expected modal_closure.output)))


(env
 (_
  (flags
   (:standard -w -26 -w -27))))
